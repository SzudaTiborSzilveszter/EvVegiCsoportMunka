{
    "source": {
        "include": ["modules", "ui", "data"],
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "opts": {
        "readme": "README.md",
        "destination": "./docs/",
        "recurse": true,
        "template": "node_modules/better-docs",
        "private": false,
        "lenient": true
    },
    "plugins": [
        "plugins/markdown"
    ],
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false,
        "default": {
            "outputSourceFiles": true
        }
    }
}